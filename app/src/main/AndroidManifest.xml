<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ninmods.main">

    <!-- Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_SUPERUSER" />

    <!-- Package Visibility (Android 11+) -->
    <queries>
        <package android:name="com.ghost.driver.loader" />
        <package android:name="com.dts.freefireth" />
        <package android:name="com.dts.freefiremax" />
        <package android:name="com.dts.freefirein" />
    </queries>

    <application
        android:allowBackup="false"
        android:requestLegacyExternalStorage="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name="com.ninmods.main.core.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.ninmods.main.core.DashboardActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <activity
            android:name="com.ninmods.main.core.ModeSelectActivity"
            android:exported="false"
            android:label="@string/mode_select_title" />

        <activity
            android:name="com.ninmods.main.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="stateHidden|adjustResize"
            android:label="@string/app_name" />

        <activity
            android:name="com.ninmods.main.auth.SignupActivity"
            android:exported="false"
            android:windowSoftInputMode="stateHidden|adjustResize"
            android:label="Sign Up" />

        <activity
            android:name="com.ninmods.main.auth.ResetPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="stateHidden|adjustResize"
            android:label="Reset Password" />

        <activity
            android:name="com.ninmods.main.core.DeviceInfoActivity"
            android:exported="false"
            android:label="Device Information" />

        <activity
            android:name="com.ninmods.main.core.ProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="stateHidden|adjustResize"
            android:label="Account Profile" />

        <!--
            The floating mod menu. The service owns the overlay window, exactly
            like the launcher service of the reference mod menu.
            stopWithTask="true" makes the menu disappear together with the
            task of the app, so it can never stay behind on the device.
        -->
        <service
            android:name="com.ninmods.main.menu.MenuOverlayService"
            android:enabled="true"
            android:exported="false"
            android:stopWithTask="true" />

    </application>

</manifest>
